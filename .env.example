# Firebase web config — copy to .env, or set these in your host's build settings.
# These values are public: they ship to the browser in every Firebase web app.
# What protects your data is the Firestore rules, not secrecy of these.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Safety caps for the Google Calendar / Tasks API, applied per browser.
# Today Google allows 600/min per user and only bills above 1,000,000/day; the
# Workspace tiering model lands later in 2026 and its standard tier is not
# published yet, so these default deliberately low. Raise them if you need to —
# no code change, just a rebuild.
# The OAuth Client ID for Google Calendar / Tasks. Public by design, and baking it
# in here saves pasting it into Settings on every device. No API key is used, and
# no client secret — the popup flow needs neither.
GOOGLE_CLIENT_ID=
# Optional. API keys are project-wide, not per-API, and OAuth calls do not need
# one — but if you have them they are sent as ?key= on their API. Safe to leave blank.
GOOGLE_CAL_API=
GOOGLE_TASKS_API=
PLAYDAY_CALLS_PER_MINUTE=120
PLAYDAY_CALLS_PER_DAY=8000
